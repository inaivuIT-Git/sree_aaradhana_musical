# Hostinger deploys this site with git, so keep repository files private.
RedirectMatch 404 /(\.git|\.github|REVIEW\.md)

# Make browsers check for a new version of each page on every visit, so deploys show up straight away.
# CSS and JS keep Hostinger's long cache; their links carry a ?v= version instead.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
